{
  "name": "@sudobility/music_ui_rn",
  "version": "0.0.3",
  "description": "Shared functional UI for ScoreSmith's React Native apps (editor shell, toolbar, transport, inspector, score view, keyboard, spatial, print) — navigation stays in the app shells",
  "type": "module",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build && node scripts/fix-esm-imports.mjs",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "scoresmith",
    "moosiac",
    "music",
    "react-native",
    "ui",
    "nativewind",
    "editor"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@react-native-community/slider": "^4.5.1",
    "@react-native-segmented-control/segmented-control": ">=2.5.0",
